{
  "expo": {
    "name": "JunctionShare",
    "slug": "junctionshare",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "junctionshare",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.junctionshare.app",
      "buildNumber": "8",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSContactsUsageDescription": "JunctionShare reads your contacts only when you choose to fill your WhatsApp number on the Profile screen.",
        "LSApplicationQueriesSchemes": ["whatsapp", "whatsapp-business"]
      }
    },
    "android": {
      "package": "com.junctionshare.app",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 8,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow JunctionShare to fill your WhatsApp number from Contacts on Profile."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F4EF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e91d1dc0-44fb-4d9a-a841-120193a26c04"
      },
      "googleMapsApiKey": ""
    },
    "owner": "futurestackservices"
  }
}
