{
  "expo": {
    "name": "JunctionShare",
    "slug": "junctionshare",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "junctionshare",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.junctionshare.app",
      "buildNumber": "8",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["whatsapp", "whatsapp-business"]
      }
    },
    "android": {
      "package": "com.junctionshare.app",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 8,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JunctionShare uses your location to show your ride request to nearby riders and to find requests near you.",
          "locationAlwaysAndWhenInUsePermission": "JunctionShare uses your location in the background while a request is active to show your request to nearby riders and to keep matching accurate if you move.",
          "locationAlwaysPermission": false,
          "motionUsagePermission": "JunctionShare does not use motion or fitness data. This permission is listed only because the location library includes optional motion features the app never turns on.",
          "isAndroidMotionActivityEnabled": false,
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F4EF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e91d1dc0-44fb-4d9a-a841-120193a26c04"
      },
      "googleMapsApiKey": ""
    },
    "owner": "futurestackservices"
  }
}
